# Keep the build context small and reproducible.
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
tests/
.env
.env.*
.git/
.gitignore
Dockerfile
.dockerignore
# NOTE: README.md is intentionally NOT ignored — pyproject.toml declares
# `readme = "README.md"`, so hatchling needs it present to build the package.
